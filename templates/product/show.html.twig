{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <h1>{{ product.name }}</h1>

    <p>{{ product.price }} €</p>
    <p>État : {{ product.state }}</p>
    <p>Catégorie : {{ product.category.name }}</p>
    <p>Ajouté le {{ product.createAt|date('d/m/Y') }}</p>

    <a href="{{  path('app_product_index') }}">Retour à la liste des produits</a>
{% endblock %}