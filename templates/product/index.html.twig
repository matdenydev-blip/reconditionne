{% extends 'base.html.twig' %}

{% block title %}Nos produits{% endblock %}

{% block body %}
    <h1>Nos produits</h1>

    {% for product in products %}
        <div>
            <h2><a href="{{ path('app_product_show', {'id': product.id}) }}">{{ product.name }}</a></h2>
            <p>{{ product.price }} €</p>
            <p>État : {{ product.state }}</p>
            <p>Catégorie : {{ product.category.name }}</p>
        </div>
    {% else %}
        <p>Aucun produit pour le moment.</p>
    {% endfor %}
{% endblock %}

