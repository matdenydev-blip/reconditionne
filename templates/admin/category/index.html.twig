{% extends 'base.html.twig' %}

{% block title %}Liste des catégories{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Liste des catégories</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_category_new') }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter une catégorie</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for category in categories %}
                <tr>
                    <td>{{ category.id }}</td>
                    <td>{{ category.name }}</td>
                    <td>{{ category.description }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_category_show', {'id': category.id}) }}"><i class="bi bi-eye" aria-hidden="true"></i> Voir</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_category_edit', {'id': category.id}) }}"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">Aucune catégorie pour le moment.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}