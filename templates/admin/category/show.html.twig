{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">{{ category.name }}</h1>

    <table class="table table-bordered bg-white">
        <tbody>
            <tr><th class="w-25">Id</th><td>{{ category.id }}</td></tr>
            <tr><th>Nom</th><td>{{ category.name }}</td></tr>
            <tr><th>Description</th><td>{{ category.description }}</td></tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_category_index') }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour à la liste</a>
        <a class="btn btn-primary" href="{{ path('app_admin_category_edit', {'id': category.id}) }}"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
        {{ include('admin/category/_delete_form.html.twig') }}
    </div>
{% endblock %}