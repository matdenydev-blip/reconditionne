{% extends 'base.html.twig' %}

{% block title %}Liste des produits{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h2 mb-0">Liste des produits</h1>
        <a class="btn btn-primary" href="{{ path('app_admin_product_new') }}"><i class="bi bi-plus-lg" aria-hidden="true"></i> Ajouter un produit</a>
    </div>

    {% set badges = {'bon': 'success', 'moyen': 'warning', 'mauvais': 'danger'} %}

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Prix</th>
                    <th>État</th>
                    <th>Catégorie</th>
                    <th>Date d'ajout</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for product in products %}
                <tr>
                    <td>{{ product.id }}</td>
                    <td>{{ product.name }}</td>
                    <td>{{ product.description }}</td>
                    <td>{{ product.price }} €</td>
                    <td><span class="badge text-bg-{{ badges[product.state]|default('secondary') }}">{{ product.state }}</span></td>
                    <td>{{ product.category.name }}</td>
                    <td>{{ product.createAt ? product.createAt|date('d/m/Y H:i') : '' }}</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_product_show', {'id': product.id}) }}"><i class="bi bi-eye" aria-hidden="true"></i> Voir</a>
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_product_edit', {'id': product.id}) }}"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">Aucun produit pour le moment.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}