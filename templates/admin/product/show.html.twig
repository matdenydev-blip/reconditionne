{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    {% set badges = {'bon': 'success', 'moyen': 'warning', 'mauvais': 'danger'} %}

    <h1 class="h2 mb-4">{{ product.name }}</h1>

    <table class="table table-bordered bg-white">
        <tbody>
            <tr><th class="w-25">Id</th><td>{{ product.id }}</td></tr>
            <tr><th>Nom</th><td>{{ product.name }}</td></tr>
            <tr><th>Description</th><td>{{ product.description }}</td></tr>
            <tr><th>Prix</th><td>{{ product.price }} €</td></tr>
            <tr><th>État</th><td><span class="badge text-bg-{{ badges[product.state]|default('secondary') }}">{{ product.state }}</span></td></tr>
            <tr><th>Catégorie</th><td>{{ product.category.name }}</td></tr>
            <tr><th>Date d'ajout</th><td>{{ product.createAt ? product.createAt|date('d/m/Y H:i') : '' }}</td></tr>
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" href="{{ path('app_admin_product_index') }}"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour à la liste</a>
        <a class="btn btn-primary" href="{{ path('app_admin_product_edit', {'id': product.id}) }}"><i class="bi bi-pencil-square" aria-hidden="true"></i> Modifier</a>
        {{ include('admin/product/_delete_form.html.twig') }}
    </div>
{% endblock %}