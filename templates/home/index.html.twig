{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    {% set badges = {'bon': 'success', 'moyen': 'warning', 'mauvais': 'danger'} %}

    <section class="bg-body-tertiary rounded-3 p-5 mb-5 text-center">
        <h1 class="display-5 fw-bold">Bienvenue chez TechReconditionné</h1>
        <p class="lead mx-auto mb-4" style="max-width: 640px;">
            Smartphones, ordinateurs et tablettes reconditionnés avec soin : des appareils de qualité, testés un par un, à des prix avantageux.
        </p>
        <a class="btn btn-primary btn-lg" href="{{ path('app_product_index') }}">
            <i class="bi bi-phone" aria-hidden="true"></i> Voir tous les produits
        </a>
    </section>

    <section class="mb-5">
        <h2 class="h3 text-center mb-4">Pourquoi choisir le reconditionné ?</h2>
        <div class="row g-4 text-center">
            <div class="col-md-4">
                <i class="bi bi-recycle display-4 text-success" aria-hidden="true"></i>
                <h3 class="h5 mt-3">Un geste pour la planète</h3>
                <p class="text-muted">Donner une seconde vie aux appareils réduit les déchets électroniques.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-shield-check display-4 text-primary" aria-hidden="true"></i>
                <h3 class="h5 mt-3">Contrôlés et testés</h3>
                <p class="text-muted">Chaque appareil est vérifié et son état est clairement indiqué.</p>
            </div>
            <div class="col-md-4">
                <i class="bi bi-piggy-bank display-4 text-warning" aria-hidden="true"></i>
                <h3 class="h5 mt-3">Des prix avantageux</h3>
                <p class="text-muted">Le même appareil, à une fraction du prix du neuf.</p>
            </div>
        </div>
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0">Nos derniers produits</h2>
            <a class="btn btn-outline-primary btn-sm" href="{{ path('app_product_index') }}">Tout voir</a>
        </div>

        <div class="row g-4">
            {% for product in products %}
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <span class="badge text-bg-{{ badges[product.state]|default('secondary') }}">{{ product.state }}</span>
                            <h3 class="h5 card-title mt-2">
                                <a class="product-name stretched-link text-decoration-none text-dark" href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a>
                            </h3>
                            <p class="card-text text-muted mb-0">{{ product.category.name }}</p>
                        </div>
                        <div class="card-footer bg-white fw-bold">{{ product.price }} €</div>
                    </div>
                </div>
            {% else %}
                <p class="text-center text-muted">Aucun produit pour le moment.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
