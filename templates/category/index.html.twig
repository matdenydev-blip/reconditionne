{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <h1 class="h2 mb-4">Liste des catégories</h1>

    <div class="row g-4">
        {% for category in categories %}
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-grid text-primary fs-3" aria-hidden="true"></i>
                        <h2 class="h5 card-title mt-2">
                            <a class="stretched-link text-decoration-none text-dark" href="{{ path('app_category_show', {'id': category.id}) }}">{{ category.name }}</a>
                        </h2>
                        <p class="card-text text-muted mb-0">{{ category.description }}</p>
                    </div>
                    <div class="card-footer bg-white text-muted small">{{ category.products|length }} produit(s)</div>
                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Aucune catégorie pour le moment.</p>
        {% endfor %}
    </div>
{% endblock %}