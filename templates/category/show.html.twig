{% extends 'base.html.twig' %}

{% block title %}{{ category.name }}{% endblock %}

{% block body %}
    {% set badges = {'bon': 'success', 'moyen': 'warning', 'mauvais': 'danger'} %}

    <nav aria-label="Fil d'Ariane">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_category_index') }}">Catégories</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
        </ol>
    </nav>

    <h1 class="h2">{{ category.name }}</h1>
    <p class="lead text-muted mb-4">{{ category.description }}</p>

    <div class="row g-4">
        {% for product in category.products %}
            <div class="col-sm-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge text-bg-{{ badges[product.state]|default('secondary') }}">{{ product.state }}</span>
                        <h2 class="h5 card-title mt-2">
                            <a class="stretched-link text-decoration-none text-dark" href="{{ path('app_product_show', {id: product.id}) }}">{{ product.name }}</a>
                        </h2>
                    </div>
                    <div class="card-footer bg-white fw-bold">{{ product.price }} €</div>
                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Cette catégorie ne contient pas encore de produit.</p>
        {% endfor %}
    </div>

    <a class="btn btn-outline-secondary mt-4" href="{{ path('app_category_index') }}">
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Retour à la liste des catégories
    </a>
{% endblock %}